# Copy to .env and adjust. Everything is optional.

# Host port the app is published on.
PORT=8000

# Names of the people who rate, comma separated. Only used the first time the
# database is created; afterwards edit them in Ajustes / Settings.
RATERS=Persona 1,Persona 2

# Shared password. Leave empty for no login (fine on a home LAN, not on the internet).
APP_PASSWORD=

# Session signing key. If empty one is generated and stored in data/secret.key.
SECRET_KEY=
