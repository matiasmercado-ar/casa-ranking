# Copy to .env and adjust. Everything is optional.

# Host port the app is published on.
PORT=8000

# Admin account created on first start. Login with ADMIN_EMAIL (default "admin").
# If ADMIN_PASSWORD is empty a random one is generated and printed once in the
# container log:  docker compose logs casa-ranking | grep "admin account"
# Both are only read when no admin exists yet; change the password in Ajustes.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session signing key. If empty one is generated and stored in data/secret.key.
SECRET_KEY=
