# Copy to deploy/deploy.env (git-ignored) and adjust to your Proxmox / LAN.
PVE_HOST=admin@192.168.1.10      # ssh target of the Proxmox node (needs passwordless sudo for pct)
CTID=107
CT_NAME=casa-ranking
CT_IP=192.168.1.107/24
CT_GW=192.168.1.1
CT_DNS=192.168.1.1
CT_STORAGE=local-zfs
CT_TEMPLATE=local:vztmpl/debian-13-standard_13.1-2_amd64.tar.zst
CT_BRIDGE=vmbr0
CT_MEMORY=1024
CT_DISK=8
SSH_PUBKEY=~/.ssh/id_ed25519.pub
APP_PORT=80                      # port published on the container's IP
